@model List<MyShop.Models.Category>
@{
    ViewData["Title"] = "Quản Lý Danh Mục - Admin";
}

<div class="container-fluid px-lg-5 py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold mb-1"><i class="bi bi-tags text-primary me-2"></i>QUẢN LÝ DANH MỤC</h3>
            <p class="text-muted small mb-0">Các phân nhóm sản phẩm áo sơ mi và áo rét</p>
        </div>
        <a asp-action="CreateCategory" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i> Thêm Danh Mục</a>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <table class="table align-middle table-hover mb-0">
            <thead class="table-dark">
                <tr>
                    <th style="width: 80px;">STT</th>
                    <th>Tên danh mục</th>
                    <th>Slug</th>
                    <th>Mô tả</th>
                    <th>Số sản phẩm</th>
                    <th>Trạng thái</th>
                    <th class="text-end" style="width: 140px;">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model)
                {
                    <tr>
                        <td>@c.DisplayOrder</td>
                        <td class="fw-bold">@c.Name</td>
                        <td><code>@c.Slug</code></td>
                        <td class="text-muted small">@c.Description</td>
                        <td><span class="badge bg-info text-dark">@c.Products.Count sản phẩm</span></td>
                        <td>
                            @if (c.IsActive)
                            {
                                <span class="badge bg-success">Hoạt động</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Tạm ẩn</span>
                            }
                        </td>
                        <td class="text-end">
                            <a asp-action="EditCategory" asp-route-id="@c.Id" class="btn btn-sm btn-outline-primary me-1"><i class="bi bi-pencil"></i></a>
                            <form asp-action="DeleteCategory" asp-route-id="@c.Id" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc muốn xóa danh mục này?');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
