@model MyShop.Models.Article
@{
    ViewData["Title"] = "Viết Bài Mới - Admin Ngọc Hiển";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="fw-bold mb-0">VIẾT BÀI MỚI</h3>
        <a asp-action="Articles" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left me-1"></i> Quay lại</a>
    </div>

    <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5">
        <form asp-action="CreateArticle" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="alert alert-danger small py-2 mb-3"></div>

            <div class="row g-3">
                <div class="col-md-8">
                    <label asp-for="Title" class="form-label fw-bold">Tiêu đề bài viết *</label>
                    <input asp-for="Title" class="form-control" placeholder="Ví dụ: Bí quyết phối áo sơ mi công sở..." />
                    <span asp-validation-for="Title" class="text-danger small"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="Author" class="form-label fw-bold">Tác giả</label>
                    <input asp-for="Author" class="form-control" value="Thời trang Ngọc Hiển" />
                    <span asp-validation-for="Author" class="text-danger small"></span>
                </div>

                <div class="col-12">
                    <label asp-for="Summary" class="form-label fw-bold">Tóm tắt ngắn (khoảng 1-2 câu) *</label>
                    <textarea asp-for="Summary" class="form-control" rows="2" placeholder="Tóm tắt nội dung bài viết thu hút người đọc..."></textarea>
                    <span asp-validation-for="Summary" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="ThumbnailUrl" class="form-label fw-bold">Đường dẫn ảnh bìa</label>
                    <input asp-for="ThumbnailUrl" class="form-control" placeholder="/images/products/so-mi/somi_01.jpg" />
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-bold">Hoặc tải lên ảnh bìa mới</label>
                    <input type="file" name="thumbnailUpload" class="form-control" accept="image/*" />
                </div>

                <div class="col-12">
                    <label asp-for="Content" class="form-label fw-bold">Nội dung bài viết (hỗ trợ mã HTML) *</label>
                    <textarea asp-for="Content" class="form-control" rows="10" placeholder="<p>Nội dung chi tiết bài viết...</p>"></textarea>
                    <span asp-validation-for="Content" class="text-danger small"></span>
                </div>

                <div class="col-12">
                    <div class="form-check form-switch mt-2">
                        <input asp-for="IsPublished" class="form-check-input" checked />
                        <label asp-for="IsPublished" class="form-check-label fw-bold">Xuất bản công khai bài viết ngay</label>
                    </div>
                </div>

                <div class="col-12 mt-4">
                    <button type="submit" class="btn btn-primary px-4 py-2"><i class="bi bi-check-lg me-1"></i> Đăng Bài Viết</button>
                    <a asp-action="Articles" class="btn btn-outline-secondary px-4 py-2 ms-2">Hủy Bỏ</a>
                </div>
            </div>
        </form>
    </div>
</div>
