@model MyShop.Models.Order
@{
    ViewData["Title"] = "Chi Tiết Đơn Hàng #" + Model.OrderCode;
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold mb-1">CHI TIẾT ĐƠN HÀNG #@Model.OrderCode</h3>
            <span class="text-muted small">Thời gian đặt: @Model.CreatedAt.ToString("dd/MM/yyyy HH:mm:ss")</span>
        </div>
        <a asp-action="Orders" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left me-1"></i> Quay lại danh sách đơn</a>
    </div>

    <div class="row g-4">
        <!-- Thông tin đơn hàng & Cập nhật trạng thái -->
        <div class="col-lg-5">
            <!-- Form cập nhật trạng thái đơn -->
            <div class="card border-0 shadow-sm rounded-4 p-4 mb-4 bg-light border-start border-primary border-4">
                <h5 class="fw-bold mb-3"><i class="bi bi-sliders text-primary me-2"></i>Cập Nhật Trạng Thái</h5>
                <form asp-action="UpdateOrderStatus" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />

                    <div class="mb-3">
                        <label class="form-label small fw-bold">Trạng thái đơn hàng</label>
                        <select name="orderStatus" class="form-select">
                            <option value="Pending" selected="@(Model.OrderStatus == "Pending")">Chờ xác nhận (Pending)</option>
                            <option value="Processing" selected="@(Model.OrderStatus == "Processing")">Đang đóng gói xử lý (Processing)</option>
                            <option value="Shipping" selected="@(Model.OrderStatus == "Shipping")">Đang giao hàng (Shipping)</option>
                            <option value="Delivered" selected="@(Model.OrderStatus == "Delivered")">Đã giao thành công (Delivered)</option>
                            <option value="Cancelled" selected="@(Model.OrderStatus == "Cancelled")">Đã hủy đơn (Cancelled)</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-bold">Trạng thái thanh toán</label>
                        <select name="paymentStatus" class="form-select">
                            <option value="Pending" selected="@(Model.PaymentStatus == "Pending")">Chờ thanh toán (Pending)</option>
                            <option value="Paid" selected="@(Model.PaymentStatus == "Paid")">Đã nhận thanh toán (Paid)</option>
                            <option value="Refunded" selected="@(Model.PaymentStatus == "Refunded")">Đã hoàn tiền (Refunded)</option>
                        </select>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 py-2 fw-bold">
                        <i class="bi bi-check2-circle me-1"></i> Cập Nhật Ngay
                    </button>
                </form>
            </div>

            <!-- Khách hàng -->
            <div class="card border-0 shadow-sm rounded-4 p-4 mb-4">
                <h5 class="fw-bold mb-3 border-bottom pb-2">Thông Tin Khách Hàng</h5>
                <p class="mb-1"><strong>Họ tên:</strong> @Model.CustomerName</p>
                <p class="mb-1"><strong>Điện thoại:</strong> <a href="tel:@Model.CustomerPhone" class="text-decoration-none">@Model.CustomerPhone</a></p>
                @if (!string.IsNullOrEmpty(Model.CustomerEmail))
                {
                    <p class="mb-1"><strong>Email:</strong> @Model.CustomerEmail</p>
                }
                <p class="mb-1"><strong>Địa chỉ giao:</strong> @Model.ShippingAddress</p>
                <p class="mb-1"><strong>Tỉnh / TP:</strong> @Model.City</p>
                @if (!string.IsNullOrEmpty(Model.Notes))
                {
                    <div class="alert alert-warning small p-2 mt-2 mb-0">
                        <strong>Ghi chú từ khách:</strong> @Model.Notes
                    </div>
                }
            </div>

            <!-- Thanh toán -->
            <div class="card border-0 shadow-sm rounded-4 p-4">
                <h5 class="fw-bold mb-3 border-bottom pb-2">Thông Tin Thanh Toán</h5>
                <p class="mb-1"><strong>Phương thức:</strong> @Model.PaymentMethod</p>
                <p class="mb-1">
                    <strong>Trạng thái thanh toán:</strong>
                    <span class="badge @(Model.PaymentStatus == "Paid" ? "bg-success" : "bg-warning text-dark")">@Model.PaymentStatus</span>
                </p>
                @if (Model.PaidAt.HasValue)
                {
                    <p class="mb-0 small text-muted">Thanh toán lúc: @Model.PaidAt.Value.ToString("dd/MM/yyyy HH:mm")</p>
                }
            </div>
        </div>

        <!-- Chi tiết sản phẩm trong đơn -->
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm rounded-4 p-4 mb-4">
                <h5 class="fw-bold mb-3 border-bottom pb-2">Danh Sách Sản Phẩm Trong Đơn</h5>

                <div class="table-responsive">
                    <table class="table align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Sản phẩm</th>
                                <th class="text-center">Size / Màu</th>
                                <th class="text-center">Đơn giá</th>
                                <th class="text-center">SL</th>
                                <th class="text-end">Thành tiền</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.OrderItems)
                            {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <img src="@item.ProductImage" alt="@item.ProductName" class="rounded me-2" style="width: 50px; height: 50px; object-fit: cover;" />
                                            <div>
                                                <div class="fw-bold small">@item.ProductName</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="text-center small">
                                        <span class="badge bg-light text-dark border">@item.SelectedSize</span>
                                    </td>
                                    <td class="text-center small">@item.UnitPrice.ToString("N0") đ</td>
                                    <td class="text-center small">@item.Quantity</td>
                                    <td class="text-end fw-bold text-danger">@item.TotalPrice.ToString("N0") đ</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr>
                                <td colspan="4" class="text-end text-muted small">Tạm tính tiền hàng:</td>
                                <td class="text-end fw-semibold">@Model.SubTotal.ToString("N0") đ</td>
                            </tr>
                            <tr>
                                <td colspan="4" class="text-end text-muted small">Phí vận chuyển:</td>
                                <td class="text-end fw-semibold">
                                    @(Model.ShippingFee == 0 ? "Miễn phí" : Model.ShippingFee.ToString("N0") + " đ")
                                </td>
                            </tr>
                            <tr class="fs-5">
                                <td colspan="4" class="text-end fw-bold">Tổng thanh toán:</td>
                                <td class="text-end fw-bold text-danger">@Model.TotalAmount.ToString("N0") đ</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>

                <div class="mt-3 text-center">
                    <button class="btn btn-outline-dark btn-sm" onclick="window.print()">
                        <i class="bi bi-printer me-1"></i> In phiếu giao hàng
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>
