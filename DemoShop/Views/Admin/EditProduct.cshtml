@model MyShop.Models.Product
@{
    ViewData["Title"] = "Chỉnh Sửa Sản Phẩm: " + Model.Name;
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="fw-bold mb-0">CHỈNH SỬA SẢN PHẨM</h3>
        <a asp-action="Products" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left me-1"></i> Quay lại</a>
    </div>

    <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5">
        <form asp-action="EditProduct" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="CreatedAt" />
            <input type="hidden" asp-for="Slug" />

            <div asp-validation-summary="ModelOnly" class="alert alert-danger small py-2 mb-3"></div>

            <div class="row g-3">
                <div class="col-md-8">
                    <label asp-for="Name" class="form-label fw-bold">Tên sản phẩm *</label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="CategoryId" class="form-label fw-bold">Danh mục *</label>
                    <select asp-for="CategoryId" class="form-select" asp-items="ViewBag.CategoryId"></select>
                    <span asp-validation-for="CategoryId" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Price" class="form-label fw-bold">Giá bán thực tế (VNĐ) *</label>
                    <input asp-for="Price" type="number" class="form-control" />
                    <span asp-validation-for="Price" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="OriginalPrice" class="form-label fw-bold">Giá gốc niêm yết (VNĐ)</label>
                    <input asp-for="OriginalPrice" type="number" class="form-control" />
                    <span asp-validation-for="OriginalPrice" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Material" class="form-label fw-bold">Chất liệu vải</label>
                    <input asp-for="Material" class="form-control" />
                    <span asp-validation-for="Material" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="StockQuantity" class="form-label fw-bold">Số lượng trong kho</label>
                    <input asp-for="StockQuantity" type="number" class="form-control" />
                    <span asp-validation-for="StockQuantity" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Sizes" class="form-label fw-bold">Các Size hỗ trợ</label>
                    <input asp-for="Sizes" class="form-control" />
                    <span asp-validation-for="Sizes" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Colors" class="form-label fw-bold">Màu sắc</label>
                    <input asp-for="Colors" class="form-control" />
                    <span asp-validation-for="Colors" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="ImageUrl" class="form-label fw-bold">Đường dẫn ảnh</label>
                    <input asp-for="ImageUrl" class="form-control" />
                    <span asp-validation-for="ImageUrl" class="text-danger small"></span>
                    @if (!string.IsNullOrEmpty(Model.ImageUrl))
                    {
                        <div class="mt-2">
                            <img src="@Model.ImageUrl" alt="Preview" class="rounded" style="max-height: 80px;" />
                        </div>
                    }
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-bold">Tải lên ảnh mới (thay thế)</label>
                    <input type="file" name="imageUpload" class="form-control" accept="image/*" />
                </div>

                <div class="col-12">
                    <label asp-for="Description" class="form-label fw-bold">Mô tả chi tiết sản phẩm</label>
                    <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <div class="form-check form-switch mt-2">
                        <input asp-for="IsFeatured" class="form-check-input" />
                        <label asp-for="IsFeatured" class="form-check-label fw-bold">Đặt làm sản phẩm Nổi Bật</label>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-check form-switch mt-2">
                        <input asp-for="IsActive" class="form-check-input" />
                        <label asp-for="IsActive" class="form-check-label fw-bold">Kích hoạt hiển thị</label>
                    </div>
                </div>

                <div class="col-12 mt-4">
                    <button type="submit" class="btn btn-primary px-4 py-2"><i class="bi bi-save me-1"></i> Cập Nhật Sản Phẩm</button>
                    <a asp-action="Products" class="btn btn-outline-secondary px-4 py-2 ms-2">Hủy Bỏ</a>
                </div>
            </div>
        </form>
    </div>
</div>
