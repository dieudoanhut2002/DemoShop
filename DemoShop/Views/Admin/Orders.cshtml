@model List<MyShop.Models.Order>
@{
    ViewData["Title"] = "Quản Lý Đơn Hàng - Admin Ngọc Hiển";
}

<div class="container-fluid px-lg-5 py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold mb-1"><i class="bi bi-receipt text-primary me-2"></i>QUẢN LÝ ĐƠN HÀNG</h3>
            <p class="text-muted small mb-0">Theo dõi, duyệt đơn hàng và đối soát thanh toán VietQR / COD</p>
        </div>
    </div>

    <!-- Bộ lọc trạng thái đơn -->
    <div class="card border-0 shadow-sm rounded-4 p-3 mb-4">
        <div class="d-flex flex-wrap gap-2">
            <a asp-action="Orders" class="btn btn-sm @(ViewBag.CurrentStatus == null ? "btn-dark" : "btn-outline-dark")">Tất cả (@Model.Count)</a>
            <a asp-action="Orders" asp-route-status="Pending" class="btn btn-sm @(ViewBag.CurrentStatus == "Pending" ? "btn-warning" : "btn-outline-warning text-dark")">Chờ xác nhận</a>
            <a asp-action="Orders" asp-route-status="Processing" class="btn btn-sm @(ViewBag.CurrentStatus == "Processing" ? "btn-info text-dark" : "btn-outline-info text-dark")">Đang xử lý</a>
            <a asp-action="Orders" asp-route-status="Shipping" class="btn btn-sm @(ViewBag.CurrentStatus == "Shipping" ? "btn-primary" : "btn-outline-primary")">Đang giao hàng</a>
            <a asp-action="Orders" asp-route-status="Delivered" class="btn btn-sm @(ViewBag.CurrentStatus == "Delivered" ? "btn-success" : "btn-outline-success")">Đã giao thành công</a>
            <a asp-action="Orders" asp-route-status="Cancelled" class="btn btn-sm @(ViewBag.CurrentStatus == "Cancelled" ? "btn-danger" : "btn-outline-danger")">Đã hủy</a>
        </div>
    </div>

    <!-- Bảng danh sách đơn hàng -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table align-middle table-hover mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Mã đơn</th>
                        <th>Ngày đặt</th>
                        <th>Khách hàng</th>
                        <th>Địa chỉ giao</th>
                        <th>Tổng tiền</th>
                        <th>Phương thức</th>
                        <th>Thanh toán</th>
                        <th>Trạng thái đơn</th>
                        <th class="text-end" style="width: 120px;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="9" class="text-center py-4 text-muted">Không có đơn hàng nào phù hợp với bộ lọc.</td>
                        </tr>
                    }
                    @foreach (var o in Model)
                    {
                        <tr>
                            <td><strong class="text-primary">#@o.OrderCode</strong></td>
                            <td class="small">@o.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>
                                <div class="fw-bold">@o.CustomerName</div>
                                <small class="text-muted">@o.CustomerPhone</small>
                            </td>
                            <td class="small" style="max-width: 220px;">@o.ShippingAddress, @o.City</td>
                            <td class="fw-bold text-danger">@o.TotalAmount.ToString("N0") đ</td>
                            <td>
                                <span class="badge @(o.PaymentMethod == "VietQR" ? "bg-info text-dark" : "bg-light text-dark border")">
                                    @o.PaymentMethod
                                </span>
                            </td>
                            <td>
                                @if (o.PaymentStatus == "Paid")
                                {
                                    <span class="badge bg-success"><i class="bi bi-check-circle"></i> Đã thanh toán</span>
                                }
                                else if (o.PaymentStatus == "Refunded")
                                {
                                    <span class="badge bg-secondary">Hoàn tiền</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark"><i class="bi bi-clock"></i> Chờ thanh toán</span>
                                }
                            </td>
                            <td>
                                <span class="badge @(o.OrderStatus == "Delivered" ? "bg-success" : (o.OrderStatus == "Cancelled" ? "bg-danger" : (o.OrderStatus == "Shipping" ? "bg-primary" : "bg-warning text-dark")))">
                                    @(o.OrderStatus switch {
                                        "Pending" => "Chờ xác nhận",
                                        "Processing" => "Đang đóng gói",
                                        "Shipping" => "Đang giao",
                                        "Delivered" => "Đã giao",
                                        "Cancelled" => "Đã hủy",
                                        _ => o.OrderStatus
                                    })
                                </span>
                            </td>
                            <td class="text-end">
                                <a asp-action="OrderDetail" asp-route-id="@o.Id" class="btn btn-sm btn-outline-primary" title="Xem chi tiết & Cập nhật">
                                    <i class="bi bi-pencil-square me-1"></i> Xử lý
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
