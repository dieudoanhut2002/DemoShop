@model MyShop.Models.Category
@{
    ViewData["Title"] = "Thêm Danh Mục Mới";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="fw-bold mb-0">THÊM DANH MỤC MỚI</h3>
        <a asp-action="Categories" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left me-1"></i> Quay lại</a>
    </div>

    <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5" style="max-width: 700px;">
        <form asp-action="CreateCategory" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="alert alert-danger small py-2 mb-3"></div>

            <div class="mb-3">
                <label asp-for="Name" class="form-label fw-bold">Tên danh mục *</label>
                <input asp-for="Name" class="form-control" placeholder="Ví dụ: Áo Sơ Mi Nam Công Sở" />
                <span asp-validation-for="Name" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Slug" class="form-label fw-bold">Slug (để trống sẽ tự sinh)</label>
                <input asp-for="Slug" class="form-control" placeholder="ao-so-mi-nam" />
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label fw-bold">Mô tả danh mục</label>
                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
            </div>

            <div class="mb-3">
                <label asp-for="DisplayOrder" class="form-label fw-bold">Thứ tự hiển thị</label>
                <input asp-for="DisplayOrder" type="number" class="form-control" value="0" />
            </div>

            <div class="form-check form-switch mb-4">
                <input asp-for="IsActive" class="form-check-input" checked />
                <label asp-for="IsActive" class="form-check-label fw-bold">Kích hoạt danh mục</label>
            </div>

            <button type="submit" class="btn btn-primary px-4 py-2"><i class="bi bi-check-lg me-1"></i> Lưu Danh Mục</button>
            <a asp-action="Categories" class="btn btn-outline-secondary px-4 py-2 ms-2">Hủy Bỏ</a>
        </form>
    </div>
</div>
