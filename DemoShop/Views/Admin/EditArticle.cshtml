@model MyShop.Models.Article
@{
    ViewData["Title"] = "Chỉnh Sửa Bài Viết: " + Model.Title;
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="fw-bold mb-0">CHỈNH SỬA BÀI VIẾT</h3>
        <a asp-action="Articles" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left me-1"></i> Quay lại</a>
    </div>

    <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5">
        <form asp-action="EditArticle" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="PublishedAt" />
            <input type="hidden" asp-for="ViewCount" />
            <input type="hidden" asp-for="Slug" />

            <div asp-validation-summary="ModelOnly" class="alert alert-danger small py-2 mb-3"></div>

            <div class="row g-3">
                <div class="col-md-8">
                    <label asp-for="Title" class="form-label fw-bold">Tiêu đề bài viết *</label>
                    <input asp-for="Title" class="form-control" />
                    <span asp-validation-for="Title" class="text-danger small"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="Author" class="form-label fw-bold">Tác giả</label>
                    <input asp-for="Author" class="form-control" />
                    <span asp-validation-for="Author" class="text-danger small"></span>
                </div>

                <div class="col-12">
                    <label asp-for="Summary" class="form-label fw-bold">Tóm tắt ngắn *</label>
                    <textarea asp-for="Summary" class="form-control" rows="2"></textarea>
                    <span asp-validation-for="Summary" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="ThumbnailUrl" class="form-label fw-bold">Đường dẫn ảnh bìa</label>
                    <input asp-for="ThumbnailUrl" class="form-control" />
                    @if (!string.IsNullOrEmpty(Model.ThumbnailUrl))
                    {
                        <div class="mt-2">
                            <img src="@Model.ThumbnailUrl" alt="Thumbnail" class="rounded" style="max-height: 80px;" />
                        </div>
                    }
                </div>

                <div class="col-md-6">
                    <label class="form-label fw-bold">Tải lên ảnh mới (thay thế)</label>
                    <input type="file" name="thumbnailUpload" class="form-control" accept="image/*" />
                </div>

                <div class="col-12">
                    <label asp-for="Content" class="form-label fw-bold">Nội dung bài viết (hỗ trợ mã HTML) *</label>
                    <textarea asp-for="Content" class="form-control" rows="12"></textarea>
                    <span asp-validation-for="Content" class="text-danger small"></span>
                </div>

                <div class="col-12">
                    <div class="form-check form-switch mt-2">
                        <input asp-for="IsPublished" class="form-check-input" />
                        <label asp-for="IsPublished" class="form-check-label fw-bold">Xuất bản công khai bài viết</label>
                    </div>
                </div>

                <div class="col-12 mt-4">
                    <button type="submit" class="btn btn-primary px-4 py-2"><i class="bi bi-save me-1"></i> Cập Nhật Bài Viết</button>
                    <a asp-action="Articles" class="btn btn-outline-secondary px-4 py-2 ms-2">Hủy Bỏ</a>
                </div>
            </div>
        </form>
    </div>
</div>
