@model List<MyShop.Models.CartItem>
@{
    ViewData["Title"] = "Giỏ Hàng Của Bạn - Thời Trang Ngọc Hiển";
    decimal subTotal = ViewBag.SubTotal ?? 0;
    decimal shippingFee = ViewBag.ShippingFee ?? 0;
    decimal totalAmount = ViewBag.TotalAmount ?? 0;
    decimal freeShipRemaining = 500000 - subTotal;
}

<div class="container py-4">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Trang chủ</a></li>
            <li class="breadcrumb-item active" aria-current="page">Giỏ hàng (@Model.Sum(i => i.Quantity) món)</li>
        </ol>
    </nav>

    <h3 class="fw-bold mb-4">GIỎ HÀNG CỦA BẠN</h3>

    @if (!Model.Any())
    {
        <div class="card border-0 shadow-sm rounded-4 p-5 text-center">
            <i class="bi bi-cart-x fs-1 text-muted mb-3"></i>
            <h4>Giỏ hàng của bạn đang trống</h4>
            <p class="text-muted mb-4">Hãy chọn cho mình những chiếc áo sơ mi hoặc áo rét ưng ý nhất từ bộ sưu tập Ngọc Hiển.</p>
            <div class="d-flex justify-content-center gap-3">
                <a asp-controller="Home" asp-action="Products" asp-route-categoryId="1" class="btn btn-dark">Xem Áo Sơ Mi</a>
                <a asp-controller="Home" asp-action="Products" asp-route-categoryId="2" class="btn btn-accent">Xem Áo Rét Mùa Đông</a>
            </div>
        </div>
    }
    else
    {
        <!-- Thanh tiến độ Free Shipping -->
        <div class="alert alert-info border-0 rounded-3 mb-4 shadow-sm">
            @if (freeShipRemaining > 0)
            {
                <div class="d-flex align-items-center mb-2">
                    <i class="bi bi-truck text-primary fs-5 me-2"></i>
                    <span>Bạn chỉ cần mua thêm <strong>@freeShipRemaining.ToString("N0") đ</strong> để được <strong>MIỄN PHÍ VẬN CHUYỂN TOÀN QUỐC!</strong></span>
                </div>
                <div class="progress" style="height: 8px;">
                    <div class="progress-bar bg-success" role="progressbar" style="width: @(Math.Min(100, Math.Round(subTotal / 500000 * 100)))%;"></div>
                </div>
            }
            else
            {
                <div class="d-flex align-items-center">
                    <i class="bi bi-check-circle-fill text-success fs-5 me-2"></i>
                    <span class="text-success fw-bold">Tuyệt vời! Bạn đã đủ điều kiện được MIỄN PHÍ VẬN CHUYỂN TOÀN QUỐC!</span>
                </div>
            }
        </div>

        <div class="row g-4">
            <!-- Danh sách sản phẩm trong giỏ -->
            <div class="col-lg-8">
                <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-3">
                    <div class="table-responsive">
                        <table class="table align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th style="width: 45%;">Sản phẩm</th>
                                    <th class="text-center">Đơn giá</th>
                                    <th class="text-center" style="width: 140px;">Số lượng</th>
                                    <th class="text-end">Thành tiền</th>
                                    <th class="text-center" style="width: 50px;"></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td>
                                            <div class="d-flex align-items-center">
                                                <img src="@item.ProductImage" alt="@item.ProductName" class="rounded-3 me-3" style="width: 70px; height: 70px; object-fit: cover;" />
                                                <div>
                                                    <h6 class="mb-1 fw-bold">
                                                        <a asp-controller="Home" asp-action="ProductDetail" asp-route-id="@item.ProductId" class="text-decoration-none text-dark">@item.ProductName</a>
                                                    </h6>
                                                    <div class="small">
                                                        <span class="badge bg-light text-dark border me-1">Size: @item.SelectedSize</span>
                                                        <span class="badge bg-light text-secondary border">Màu: @item.SelectedColor</span>
                                                    </div>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="text-center fw-semibold">@item.UnitPrice.ToString("N0") đ</td>
                                        <td>
                                            <form asp-action="UpdateQuantity" method="post" class="d-flex justify-content-center">
                                                <input type="hidden" name="productId" value="@item.ProductId" />
                                                <input type="hidden" name="size" value="@item.SelectedSize" />
                                                <div class="input-group input-group-sm" style="width: 110px;">
                                                    <button type="submit" name="quantity" value="@(item.Quantity - 1)" class="btn btn-outline-secondary">-</button>
                                                    <input type="text" class="form-control text-center bg-white" readonly value="@item.Quantity" />
                                                    <button type="submit" name="quantity" value="@(item.Quantity + 1)" class="btn btn-outline-secondary">+</button>
                                                </div>
                                            </form>
                                        </td>
                                        <td class="text-end fw-bold text-danger">@item.TotalPrice.ToString("N0") đ</td>
                                        <td class="text-center">
                                            <a asp-action="Remove" asp-route-productId="@item.ProductId" asp-route-size="@item.SelectedSize" class="text-danger" title="Xóa khỏi giỏ" onclick="return confirm('Bạn có chắc muốn xóa món này?');">
                                                <i class="bi bi-trash3 fs-5"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="d-flex justify-content-between">
                    <a asp-controller="Home" asp-action="Products" class="btn btn-outline-dark btn-sm">
                        <i class="bi bi-arrow-left me-1"></i> Tiếp tục mua hàng
                    </a>
                    <a asp-action="Clear" class="btn btn-outline-danger btn-sm" onclick="return confirm('Bạn có chắc muốn làm trống giỏ hàng?');">
                        <i class="bi bi-trash me-1"></i> Xóa tất cả
                    </a>
                </div>
            </div>

            <!-- Tóm tắt đơn hàng & Nút thanh toán -->
            <div class="col-lg-4">
                <div class="card border-0 shadow-sm rounded-4 p-4 sticky-top" style="top: 90px;">
                    <h5 class="fw-bold mb-3 border-bottom pb-2">Tóm Tắt Đơn Hàng</h5>
                    
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Tạm tính tiền hàng:</span>
                        <span class="fw-semibold">@subTotal.ToString("N0") đ</span>
                    </div>

                    <div class="d-flex justify-content-between mb-3">
                        <span class="text-muted">Phí vận chuyển:</span>
                        @if (shippingFee == 0)
                        {
                            <span class="text-success fw-bold">MIỄN PHÍ</span>
                        }
                        else
                        {
                            <span class="fw-semibold">@shippingFee.ToString("N0") đ</span>
                        }
                    </div>

                    <div class="border-top pt-3 mb-4">
                        <div class="d-flex justify-content-between align-items-baseline">
                            <span class="fw-bold fs-5">Tổng thanh toán:</span>
                            <span class="fs-4 fw-bold text-danger">@totalAmount.ToString("N0") đ</span>
                        </div>
                        <span class="text-muted small">(Đã bao gồm VAT và ưu đãi giao hàng)</span>
                    </div>

                    <div class="d-grid gap-2">
                        <a asp-controller="Order" asp-action="Checkout" class="btn btn-accent btn-lg py-3 fw-bold">
                            <i class="bi bi-credit-card me-2"></i> Tiến Hành Đặt Hàng
                        </a>
                    </div>

                    <div class="mt-3 p-3 bg-light rounded-3 text-center small text-muted">
                        <i class="bi bi-shield-lock-fill text-success me-1"></i> Bảo mật thanh toán an toàn 100% qua mã VietQR và COD
                    </div>
                </div>
            </div>
        </div>
    }
</div>
