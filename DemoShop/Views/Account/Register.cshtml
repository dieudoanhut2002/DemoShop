@model MyShop.Models.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Đăng Ký Tài Khoản";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card border-0 shadow-lg rounded-4 p-4 p-md-5">
                <div class="text-center mb-4">
                    <span class="brand-title">NGỌC HIỂN</span>
                    <span class="brand-subtitle mb-3">FASHION & ELEGANCE</span>
                    <h4 class="fw-bold mt-2">ĐĂNG KÝ TÀI KHOẢN</h4>
                    <p class="text-muted small">Tạo tài khoản để nhận ưu đãi thành viên</p>
                </div>

                <form asp-action="Register" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger small py-2 mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label small fw-bold">Địa chỉ Email</label>
                        <input asp-for="Email" class="form-control" placeholder="user@gmail.com" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label small fw-bold">Mật khẩu</label>
                        <input asp-for="Password" class="form-control" placeholder="••••••••" />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="ConfirmPassword" class="form-label small fw-bold">Xác nhận mật khẩu</label>
                        <input asp-for="ConfirmPassword" class="form-control" placeholder="••••••••" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-dark w-100 py-2 fw-bold mb-3">Tạo Tài Khoản</button>

                    <div class="text-center small">
                        Đã có tài khoản? <a asp-action="Login" class="text-danger fw-bold text-decoration-none">Đăng nhập</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
