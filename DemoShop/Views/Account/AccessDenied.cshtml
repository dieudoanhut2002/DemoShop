@{
    ViewData["Title"] = "Không Có Quyền Truy Cập";
}

<div class="container py-5 text-center">
    <div class="card border-0 shadow-sm rounded-4 p-5 d-inline-block" style="max-width: 550px;">
        <i class="bi bi-shield-lock-fill text-danger fs-1 mb-3"></i>
        <h3 class="fw-bold text-danger">Truy Cập Bị Từ Chối</h3>
        <p class="text-muted">Bạn không có quyền quản trị viên (Admin) để truy cập trang này. Vui lòng đăng nhập với tài khoản có quyền.</p>
        <a asp-controller="Account" asp-action="Login" class="btn btn-dark">Đăng nhập tài khoản khác</a>
        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary ms-2">Về trang chủ</a>
    </div>
</div>
