@{
    ViewData["Title"] = "Về Hãng Thời Trang Ngọc Hiển";
}

<div class="container py-4">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Trang chủ</a></li>
            <li class="breadcrumb-item active" aria-current="page">Về Ngọc Hiển</li>
        </ol>
    </nav>

    <div class="row align-items-center g-5 mb-5">
        <div class="col-lg-6">
            <span class="badge bg-warning text-dark px-3 py-2 text-uppercase mb-2">Thương Hiệu Thời Trang Việt</span>
            <h2 class="fw-bold mb-3">HÃNG THỜI TRANG NGỌC HIỂN</h2>
            <h5 class="text-danger fw-semibold mb-3">Đỉnh cao phong cách công sở và trang phục mùa đông</h5>
            <p class="text-muted lh-lg">
                Được thành lập với sứ mệnh mang đến cho phái mạnh và người tiêu dùng Việt Nam những trang phục vừa vặn hoàn hảo, tôn vinh khí chất lịch thiệp nhưng vẫn đảm bảo sự thoải mái tối đa trong mọi điều kiện thời tiết.
            </p>
            <p class="text-muted lh-lg">
                Chúng tôi chuyên sâu vào hai dòng sản phẩm cốt lõi:
            </p>
            <ul class="text-muted lh-lg">
                <li><strong>Áo sơ mi nam công sở:</strong> Ứng dụng công nghệ vải sợi tre tự nhiên Bamboo kháng khuẩn, vải thông hơi chống nhăn, giữ phom đứng chuẩn mực.</li>
                <li><strong>Áo rét & Áo khoác mùa đông:</strong> Dòng áo phao lông vũ siêu nhẹ, áo chần bông 3 lớp cản gió chống nước tuyệt đối, bảo vệ sức khỏe trọn vẹn trong mùa đông đại hàn.</li>
            </ul>
        </div>
        <div class="col-lg-6">
            <div class="row g-3">
                <div class="col-6">
                    <img src="/images/products/so-mi/somi_25.jpg" class="img-fluid rounded-4 shadow-sm" alt="Sơ mi Ngọc Hiển" />
                </div>
                <div class="col-6">
                    <img src="/images/products/ao-ret/aoret_01.jpg" class="img-fluid rounded-4 shadow-sm" alt="Áo rét Ngọc Hiển" />
                </div>
            </div>
        </div>
    </div>

    <!-- Hệ thống showroom -->
    <div class="p-4 p-md-5 bg-light rounded-4 mb-5">
        <div class="text-center mb-4">
            <h3 class="fw-bold">HỆ THỐNG SHOWROOM & ĐIỂM BÁN</h3>
            <p class="text-muted">Kính mời quý khách đến trải nghiệm sản phẩm trực tiếp</p>
        </div>
        <div class="row g-4">
            <div class="col-md-6">
                <div class="card h-100 border-0 p-4 shadow-sm rounded-3">
                    <h5 class="fw-bold text-danger"><i class="bi bi-geo-alt-fill me-2"></i>Showroom Phố Huế</h5>
                    <p class="mb-1"><strong>Địa chỉ:</strong> Số 168 Phố Huế, Quận Hai Bà Trưng, TP. Hà Nội</p>
                    <p class="mb-1"><strong>Hotline:</strong> 0988.889.999</p>
                    <p class="mb-0"><strong>Giờ mở cửa:</strong> 08:30 - 22:00 tất cả các ngày trong tuần</p>
                </div>
            </div>
            <div class="col-md-6">
                <div class="card h-100 border-0 p-4 shadow-sm rounded-3">
                    <h5 class="fw-bold text-danger"><i class="bi bi-geo-alt-fill me-2"></i>Showroom Cầu Giấy</h5>
                    <p class="mb-1"><strong>Địa chỉ:</strong> Số 245 Đường Cầu Giấy, Quận Cầu Giấy, TP. Hà Nội</p>
                    <p class="mb-1"><strong>Hotline:</strong> 0988.889.999</p>
                    <p class="mb-0"><strong>Giờ mở cửa:</strong> 08:30 - 22:00 tất cả các ngày trong tuần</p>
                </div>
            </div>
        </div>
    </div>
</div>
