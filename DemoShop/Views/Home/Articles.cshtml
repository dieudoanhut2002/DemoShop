@model List<MyShop.Models.Article>
@{
    ViewData["Title"] = "Cẩm Nang & Xu Hướng Thời Trang - Hãng Ngọc Hiển";
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
}

<div class="container py-4">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Trang chủ</a></li>
            <li class="breadcrumb-item active" aria-current="page">Cẩm nang & Tin tức thời trang</li>
        </ol>
    </nav>

    <div class="text-center mb-5">
        <span class="text-danger fw-bold text-uppercase small">Ngọc Hiển Fashion Blog</span>
        <h2 class="fw-bold">CẨM NANG & XU HƯỚNG THỜI TRANG 2026</h2>
        <p class="text-muted">Cập nhật những mẹo phối đồ công sở lịch lãm, cách bảo quản áo rét lông vũ và xu hướng thời trang mới nhất.</p>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <p class="text-muted">Chưa có bài viết nào được đăng tải.</p>
        </div>
    }
    else
    {
        <div class="row g-4 mb-5">
            @foreach (var art in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden">
                        <a asp-action="ArticleDetail" asp-route-id="@art.Id">
                            <img src="@art.ThumbnailUrl" class="card-img-top" style="height: 220px; object-fit: cover;" alt="@art.Title" />
                        </a>
                        <div class="card-body d-flex flex-column p-4">
                            <div class="d-flex justify-content-between text-muted small mb-2">
                                <span><i class="bi bi-calendar3 me-1"></i> @art.PublishedAt.ToString("dd/MM/yyyy")</span>
                                <span><i class="bi bi-eye me-1"></i> @art.ViewCount</span>
                            </div>
                            <h5 class="card-title fw-bold mb-3">
                                <a asp-action="ArticleDetail" asp-route-id="@art.Id" class="text-decoration-none text-dark">@art.Title</a>
                            </h5>
                            <p class="card-text text-muted small flex-grow-1">@art.Summary</p>
                            <div class="mt-3 pt-3 border-top d-flex justify-content-between align-items-center">
                                <span class="small text-muted"><i class="bi bi-person me-1"></i> @art.Author</span>
                                <a asp-action="ArticleDetail" asp-route-id="@art.Id" class="text-danger fw-bold small text-decoration-none">Đọc chi tiết <i class="bi bi-arrow-right"></i></a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        @if (totalPages > 1)
        {
            <nav aria-label="Article navigation">
                <ul class="pagination justify-content-center">
                    @for (int p = 1; p <= totalPages; p++)
                    {
                        <li class="page-item @(currentPage == p ? "active" : "")">
                            <a class="page-link" asp-action="Articles" asp-route-page="@p">@p</a>
                        </li>
                    }
                </ul>
            </nav>
        }
    }
</div>
