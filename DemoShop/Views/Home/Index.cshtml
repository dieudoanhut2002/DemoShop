<!-- Tin tức & Cẩm nang thời trang -->
@if (latestArticles.Any())
{
    <section class="container mb-5">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <span class="text-uppercase text-muted fw-bold small">Cập Nhật Mới Nhất</span>
                <h3 class="fw-bold mb-0">CẨM NANG & XU HƯỚNG THỜI TRANG</h3>
            </div>
            <a asp-controller="Home" asp-action="Articles" class="btn btn-outline-dark btn-sm">Xem tất cả bài viết</a>
        </div>
        <div class="row g-4">
            @foreach (var art in latestArticles)
            {
                <div class="col-md-4">
                    <div class="card h-100 border-0 shadow-sm rounded-3 overflow-hidden">
                        <img src="@art.ThumbnailUrl" class="card-img-top" style="height: 200px; object-fit: cover;" alt="@art.Title">
                        <div class="card-body d-flex flex-column">
                            <span class="text-muted small mb-2"><i class="bi bi-calendar3 me-1"></i> @art.PublishedAt.ToString("dd/MM/yyyy") - @art.Author</span>
                            <h5 class="card-title fw-bold">
                                <a asp-controller="Home" asp-action="ArticleDetail" asp-route-id="@art.Id" class="text-decoration-none text-dark">@art.Title</a>
                            </h5>
                            <p class="card-text text-muted small flex-grow-1">@art.Summary</p>
                            <a asp-controller="Home" asp-action="ArticleDetail" asp-route-id="@art.Id" class="text-danger fw-bold small text-decoration-none mt-2">Đọc tiếp <i class="bi bi-arrow-right"></i></a>
                        </div>
                    </div>
                </div>
            }
        </div>
    </section>
}
