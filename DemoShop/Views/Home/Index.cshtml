                <h3 class="fw-bold mb-0">ÁO SƠ MI NAM NGỌC HIỂN</h3>
            </div>
            <a asp-controller="Home" asp-action="Products" asp-route-categoryId="1" class="btn btn-outline-primary btn-sm">Xem thêm áo sơ mi <i class="bi bi-arrow-right ms-1"></i></a>
