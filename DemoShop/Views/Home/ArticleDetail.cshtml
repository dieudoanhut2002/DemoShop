@model MyShop.Models.Article
@{
    ViewData["Title"] = Model.Title;
    var recentArticles = ViewBag.RecentArticles as List<Article> ?? new List<Article>();
}

<div class="container py-4">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Trang chủ</a></li>
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Articles">Cẩm nang thời trang</a></li>
            <li class="breadcrumb-item active" aria-current="page">@Model.Title</li>
        </ol>
    </nav>

    <div class="row g-4">
        <div class="col-lg-8">
            <article class="card border-0 shadow-sm rounded-4 p-4 p-md-5">
                <span class="badge bg-danger align-self-start mb-2">Xu hướng & Cẩm nang</span>
                <h1 class="fw-bold mb-3">@Model.Title</h1>
                
                <div class="d-flex align-items-center text-muted small mb-4 pb-3 border-bottom">
                    <span class="me-3"><i class="bi bi-person me-1"></i> Tác giả: <strong>@Model.Author</strong></span>
                    <span class="me-3"><i class="bi bi-calendar3 me-1"></i> @Model.PublishedAt.ToString("dd/MM/yyyy HH:mm")</span>
                    <span><i class="bi bi-eye me-1"></i> @Model.ViewCount lượt đọc</span>
                </div>

                <div class="alert alert-light border-start border-danger border-4 mb-4">
                    <p class="mb-0 fst-italic">@Model.Summary</p>
                </div>

                @if (!string.IsNullOrEmpty(Model.ThumbnailUrl))
                {
                    <div class="text-center mb-4">
                        <img src="@Model.ThumbnailUrl" alt="@Model.Title" class="img-fluid rounded-3 shadow-sm" style="max-height: 450px; width: 100%; object-fit: cover;" />
                    </div>
                }

                <div class="article-content lh-lg" style="font-size: 1.05rem;">
                    @Html.Raw(Model.Content)
                </div>

                <hr class="my-4" />

                <!-- CTA Mua sắm -->
                <div class="p-4 bg-light rounded-3 text-center">
                    <h5 class="fw-bold mb-2">Trải Nghiệm Sản Phẩm Của Hãng Thời Trang Ngọc Hiển</h5>
                    <p class="text-muted small mb-3">Hơn 50+ mẫu sơ mi và áo rét cao cấp đang chờ bạn khám phá với nhiều ưu đãi hấp dẫn.</p>
                    <div class="d-flex justify-content-center gap-3">
                        <a asp-controller="Home" asp-action="Products" asp-route-categoryId="1" class="btn btn-dark btn-sm">Xem Áo Sơ Mi</a>
                        <a asp-controller="Home" asp-action="Products" asp-route-categoryId="2" class="btn btn-accent btn-sm">Xem Áo Rét Mùa Đông</a>
                    </div>
                </div>
            </article>
        </div>

        <!-- Sidebar bài viết mới -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 p-4 sticky-top" style="top: 90px;">
                <h5 class="fw-bold mb-3 border-bottom pb-2">Bài Viết Mới Nhất</h5>
                @foreach (var r in recentArticles)
                {
                    <div class="d-flex gap-3 mb-3 pb-3 border-bottom">
                        <img src="@r.ThumbnailUrl" alt="@r.Title" class="rounded" style="width: 80px; height: 60px; object-fit: cover;" />
                        <div>
                            <h6 class="mb-1" style="font-size: 0.9rem;">
                                <a asp-action="ArticleDetail" asp-route-id="@r.Id" class="text-decoration-none text-dark fw-bold">@r.Title</a>
                            </h6>
                            <span class="text-muted" style="font-size: 0.75rem;"><i class="bi bi-clock me-1"></i> @r.PublishedAt.ToString("dd/MM/yyyy")</span>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
