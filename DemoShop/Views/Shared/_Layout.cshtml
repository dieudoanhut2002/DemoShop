@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Hãng Thời Trang Ngọc Hiển | Áo Sơ Mi & Áo Rét Cao Cấp</title>
    
    <!-- Bootstrap 5.3 & Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    
    <!-- Custom Style -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <!-- Top Bar -->
    <div class="top-bar">
        <div class="container d-flex justify-content-between align-items-center">
            <div>
                <i class="bi bi-shield-check text-warning me-1"></i> Hãng Thời Trang Ngọc Hiển – Đẳng cấp thời trang Việt
                <span class="d-none d-md-inline ms-3 text-white-50">| Miễn phí giao hàng toàn quốc đơn từ 500.000đ</span>
            </div>
            <div>
                <a href="tel:0988889999" class="text-white text-decoration-none me-3"><i class="bi bi-telephone-fill text-warning me-1"></i> Hotline: 0988.889.999</a>
                <a asp-controller="Order" asp-action="Tracking" class="text-white-50 text-decoration-none"><i class="bi bi-geo-alt-fill me-1"></i> Tra cứu đơn hàng</a>
            </div>
        </div>
    </div>

    <!-- Main Navigation Bar -->
    <header class="sticky-top bg-white">
        <nav class="navbar navbar-expand-lg navbar-light border-bottom">
            <div class="container">
                <a class="navbar-brand d-flex flex-column" asp-controller="Home" asp-action="Index">
                    <span class="brand-title">NGỌC HIỂN</span>
                    <span class="brand-subtitle">FASHION & ELEGANCE</span>
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent"
                        aria-controls="navbarContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarContent">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-4">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">Trang chủ</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Products" asp-route-categoryId="1">Áo Sơ Mi Nam</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Products" asp-route-categoryId="2">Áo Rét Mùa Đông</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Products">Tất cả sản phẩm</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Articles">Cẩm nang & Xu hướng</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="About">Về Ngọc Hiển</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Contact">Liên hệ</a>
                        </li>

                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-danger fw-bold" href="#" id="adminMenu" role="button" data-bs-toggle="dropdown">
                                    <i class="bi bi-gear-fill me-1"></i> Quản trị CMS
                                </a>
                                <ul class="dropdown-menu shadow">
                                    <li><a class="dropdown-item" asp-controller="Admin" asp-action="Index"><i class="bi bi-speedometer2 me-2"></i> Tổng quan Dashboard</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item" asp-controller="Admin" asp-action="Products"><i class="bi bi-box-seam me-2"></i> Quản lý Sản phẩm</a></li>
                                    <li><a class="dropdown-item" asp-controller="Admin" asp-action="Categories"><i class="bi bi-tags me-2"></i> Quản lý Danh mục</a></li>
                                    <li><a class="dropdown-item" asp-controller="Admin" asp-action="Orders"><i class="bi bi-receipt me-2"></i> Quản lý Đơn hàng</a></li>
                                    <li><a class="dropdown-item" asp-controller="Admin" asp-action="Articles"><i class="bi bi-journal-text me-2"></i> Quản lý Bài viết</a></li>
                                </ul>
                            </li>
                        }
                    </ul>

                    <!-- Right Controls (Search, Cart, Account) -->
                    <div class="d-flex align-items-center gap-3">
                        <form class="d-none d-lg-flex" asp-controller="Home" asp-action="Products" method="get">
                            <div class="input-group">
                                <input type="text" name="search" class="form-control form-control-sm" placeholder="Tìm áo sơ mi, áo rét..." />
                                <button class="btn btn-outline-secondary btn-sm" type="submit"><i class="bi bi-search"></i></button>
                            </div>
                        </form>

                        <a asp-controller="Cart" asp-action="Index" class="btn btn-outline-dark position-relative px-3 py-1">
                            <i class="bi bi-bag-fill fs-5"></i>
                            <span id="cartCountBadge" class="cart-badge">0</span>
                        </a>

                        @if (SignInManager.IsSignedIn(User))
                        {
                            <div class="dropdown">
                                <button class="btn btn-dark btn-sm dropdown-toggle" type="button" data-bs-toggle="dropdown">
                                    <i class="bi bi-person-circle me-1"></i> @User.Identity?.Name?.Split('@')[0]
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end shadow">
                                    @if (User.IsInRole("Admin"))
                                    {
                                        <li><a class="dropdown-item text-primary" asp-controller="Admin" asp-action="Index"><i class="bi bi-speedometer2 me-2"></i> Trang quản trị</a></li>
                                        <li><hr class="dropdown-divider"></li>
                                    }
                                    <li><a class="dropdown-item" asp-controller="Order" asp-action="Tracking"><i class="bi bi-box me-2"></i> Đơn hàng của tôi</a></li>
                                    <li>
                                        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="dropdown-item text-danger"><i class="bi bi-box-arrow-right me-2"></i> Đăng xuất</button>
                                        </form>
                                    </li>
                                </ul>
                            </div>
                        }
                        else
                        {
                            <a asp-controller="Account" asp-action="Login" class="btn btn-outline-dark btn-sm"><i class="bi bi-person me-1"></i> Đăng nhập</a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <!-- Notification Messages -->
    <div class="container mt-3">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
    </div>

    <!-- Main Content Body -->
    <main role="main">
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer>
        <div class="container">
            <div class="row g-4">
                <div class="col-lg-4 col-md-6">
                    <h5>HÃNG THỜI TRANG NGỌC HIỂN</h5>
                    <p class="small text-white-50">
                        Thương hiệu thời trang công sở & mùa đông hàng đầu Việt Nam. Chúng tôi cam kết mang lại sản phẩm áo sơ mi sợi tre thoáng khí và áo rét chần bông, lông vũ cao cấp chuẩn mực may đo.
                    </p>
                    <p class="small mb-1"><i class="bi bi-geo-alt me-2 text-warning"></i> Showroom 1: 168 Phố Huế, Hai Bà Trưng, Hà Nội</p>
                    <p class="small mb-1"><i class="bi bi-geo-alt me-2 text-warning"></i> Showroom 2: 245 Cầu Giấy, Cầu Giấy, Hà Nội</p>
                    <p class="small mb-1"><i class="bi bi-telephone me-2 text-warning"></i> Hotline tư vấn: 0988.889.999</p>
                    <p class="small"><i class="bi bi-envelope me-2 text-warning"></i> Email: contact@ngochien.vn</p>
                </div>

                <div class="col-lg-2 col-md-6">
                    <h5>DANH MỤC</h5>
                    <ul class="list-unstyled small">
                        <li class="mb-2"><a asp-controller="Home" asp-action="Products" asp-route-categoryId="1">Áo sơ mi dài tay</a></li>
                        <li class="mb-2"><a asp-controller="Home" asp-action="Products" asp-route-categoryId="1">Áo sơ mi cộc tay</a></li>
                        <li class="mb-2"><a asp-controller="Home" asp-action="Products" asp-route-categoryId="1">Sơ mi sợi tre kháng khuẩn</a></li>
                        <li class="mb-2"><a asp-controller="Home" asp-action="Products" asp-route-categoryId="2">Áo phao lông vũ siêu nhẹ</a></li>
                        <li class="mb-2"><a asp-controller="Home" asp-action="Products" asp-route-categoryId="2">Áo khoác rét chần bông 3 lớp</a></li>
                        <li class="mb-2"><a asp-controller="Home" asp-action="Products" asp-route-categoryId="2">Áo bomber gió chống nước</a></li>
                    </ul>
                </div>

                <div class="col-lg-3 col-md-6">
                    <h5>CHÍNH SÁCH BÁN HÀNG</h5>
                    <ul class="list-unstyled small">
                        <li class="mb-2"><a href="#">Chính sách đổi trả trong 7 ngày</a></li>
                        <li class="mb-2"><a href="#">Chính sách bảo hành đường may, cúc áo</a></li>
                        <li class="mb-2"><a href="#">Hướng dẫn chọn size chuẩn xác</a></li>
                        <li class="mb-2"><a href="#">Chính sách bảo mật thông tin</a></li>
                        <li class="mb-2"><a asp-controller="Order" asp-action="Tracking">Tra cứu lộ trình đơn hàng</a></li>
                    </ul>
                </div>

                <div class="col-lg-3 col-md-6">
                    <h5>THANH TOÁN TIỆN LỢI</h5>
                    <p class="small text-white-50">Hỗ trợ quét mã VietQR liên ngân hàng Napas 24/7 và trả tiền mặt khi nhận hàng (COD).</p>
                    <div class="d-flex flex-wrap gap-2 mb-3">
                        <span class="badge bg-light text-dark p-2"><i class="bi bi-qr-code text-primary me-1"></i> VietQR</span>
                        <span class="badge bg-light text-dark p-2"><i class="bi bi-bank text-success me-1"></i> MB Bank</span>
                        <span class="badge bg-light text-dark p-2"><i class="bi bi-wallet2 text-danger me-1"></i> MoMo</span>
                        <span class="badge bg-light text-dark p-2"><i class="bi bi-credit-card text-info me-1"></i> VNPay</span>
                        <span class="badge bg-light text-dark p-2"><i class="bi bi-cash-stack text-warning me-1"></i> COD</span>
                    </div>
                    <div class="input-group input-group-sm mt-3">
                        <input type="email" class="form-control" placeholder="Nhận ưu đãi qua email..." />
                        <button class="btn btn-warning" type="button">Đăng ký</button>
                    </div>
                </div>
            </div>

            <hr class="border-secondary my-4">

            <div class="d-flex flex-column flex-md-row justify-content-between align-items-center small">
                <div>&copy; 2026 Hãng Thời Trang Ngọc Hiển. Tất cả quyền được bảo lưu.</div>
                <div class="mt-2 mt-md-0">
                    <span class="text-white-50 me-3">Hỗ trợ khách hàng: 24/7</span>
                    <a href="#" class="text-white me-2"><i class="bi bi-facebook fs-6"></i></a>
                    <a href="#" class="text-white me-2"><i class="bi bi-tiktok fs-6"></i></a>
                    <a href="#" class="text-white"><i class="bi bi-youtube fs-6"></i></a>
                </div>
            </div>
        </div>
    </footer>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        // Cập nhật số lượng giỏ hàng trên badge
        function updateCartBadge() {
            $.get('@Url.Action("GetCartCount", "Cart")', function(data) {
                if (data && data.count !== undefined) {
                    $('#cartCountBadge').text(data.count);
                }
            });
        }
        $(document).ready(function() {
            updateCartBadge();
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
